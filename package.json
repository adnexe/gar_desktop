{
    "name": "gar-desktop",
    "productName": "Adnexe Transport",
    "private": true,
    "version": "0.1.1",
    "type": "module",
    "main": "./out/main/index.js",
    "build": {
        "appId": "com.adnexe.caisse",
        "productName": "Adnexe transport",
        "directories": {
            "output": "release"
        },
        "files": [
            "out/**/*",
            "package.json"
        ],
        "asarUnpack": [
            "**/node_modules/pdf-to-printer/**"
        ],
        "publish": {
            "provider": "generic",
            "url": "https://adnexetransport.adnexe.com/"
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Adnexe transport"
        }
    },
    "scripts": {
        "dev": "electron-vite dev",
        "build": "vue-tsc --noEmit && electron-vite build",
        "preview": "electron-vite preview",
        "typecheck": "vue-tsc --noEmit",
        "postinstall": "electron-rebuild -f -w better-sqlite3",
        "pack": "npm run build && electron-builder --dir",
        "dist": "npm run build && electron-builder",
        "build:win": " npm version patch --no-git-tag-version  && npm run build && electron-builder -- --win",
        "build:win:nsis": "npm version patch --no-git-tag-version && npm run build && electron-builder --win nsis",
        "build:win-portable": "npm run build && electron-builder --win portable",
        "build:mac": "npm run build && electron-builder --mac"
    },
    "dependencies": {
        "@lucide/vue": "^1.17.0",
        "@vueuse/core": "^12.8.2",
        "axios": "^1.11.0",
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^12.11.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "electron-updater": "^6.8.9",
        "pdf-to-printer": "^5.8.0",
        "pinia": "^3.0.4",
        "reka-ui": "^2.9.8",
        "tailwind-merge": "^3.2.0",
        "tw-animate-css": "^1.2.5",
        "uuid": "^14.0.1",
        "vue": "^3.5.13",
        "vue-router": "^4.5.1",
        "vue-sonner": "^2.0.0"
    },
    "devDependencies": {
        "@electron/rebuild": "^4.2.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^22.10.2",
        "@vitejs/plugin-vue": "^6.0.7",
        "electron": "^43.1.1",
        "electron-builder": "^26.15.3",
        "electron-vite": "^5.0.0",
        "tailwindcss": "^4.1.1",
        "typescript": "^5.9.3",
        "vite": "^7.0.7",
        "vue-tsc": "^3.3.7"
    }
}
